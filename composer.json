{
    "name": "kreatif/validus-shopify-bridge",
    "description": "Synchronizes products and orders between the Validus ERP and Shopify.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["validus", "shopify", "erp", "sync"],
    "authors": [
        {
            "name": "kreatif"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/events": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/queue": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "autoload": {
        "psr-4": {
            "Kreatif\\ValidusShopifyBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kreatif\\ValidusShopifyBridge\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kreatif\\ValidusShopifyBridge\\ValidusShopifyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
